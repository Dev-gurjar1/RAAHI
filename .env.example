# Environment Configuration for RAAHI V2 Monorepo
NODE_ENV=development
PORT=4000
DEMO_MODE=true

# Database & Cache
DATABASE_URL=postgresql://raahi_user:raahi_password@localhost:5432/raahi_db?schema=public
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_SECRET=super_secret_raahi_jwt_key_2026_change_in_production
JWT_REFRESH_SECRET=super_secret_raahi_refresh_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth (Demo mode fallback provided if missing)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Geolocation & Maps
DEFAULT_CITY=Jaipur
DEFAULT_LAT=26.9124
DEFAULT_LNG=75.7873
MAP_PROVIDER_KEY=demo_leaflet_free_tiles

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
